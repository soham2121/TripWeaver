# Copy to .env (repo root) and fill in. Never commit .env; it is in .gitignore.
# The backend reads ../.env when started from backend/. Real environment variables override it.
# .env is read as a Java properties file: if a value contains a backslash, write it as \\.

# --- Database: Supabase (hosted PostgreSQL + PostGIS) ---------------------------------------------
# Use the Session Pooler (IPv4). The direct host db.<ref>.supabase.co is IPv6-only on the Free plan.
# Supabase dashboard > Connect > Session pooler, converted to JDBC form. Uncomment all three to use
# Supabase; leave them commented (not empty) to use the local database below.
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# SPRING_DATASOURCE_PASSWORD=
# Connection pool size. Keep it small on the Free plan.
DB_POOL_SIZE=5

# --- Database: local docker-compose PostGIS (used when SPRING_DATASOURCE_URL is empty) -------------
DB_NAME=tripweaver
DB_USER=tripweaver
DB_PASSWORD=tripweaver
DB_URL=jdbc:postgresql://127.0.0.1:5433/tripweaver

# --- Routing: self-hosted OSRM (scripts/osrm-prepare.sh, then docker compose --profile routing up -d osrm)
# Default http://127.0.0.1:5001. Set empty to use labelled straight-line estimates only.
OSRM_BASE_URL=http://127.0.0.1:5001

# Optional: set to create demo users asha, ravi and meera with this password on startup.
# Leave empty to skip; people can register in the app instead.
DEMO_PASSWORD=
