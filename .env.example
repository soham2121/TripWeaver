# Copy to .env and adjust. Never commit .env.
DB_NAME=tripweaver
DB_USER=tripweaver
DB_PASSWORD=tripweaver
DB_URL=jdbc:postgresql://127.0.0.1:5433/tripweaver

# Optional: Google Places enrichment (Phase 11). Leave empty for provider-off mode.
GOOGLE_PLACES_API_KEY=

# Routing: self-hosted OSRM (scripts/osrm-prepare.sh, then docker compose --profile routing up -d osrm).
# Default http://127.0.0.1:5001. Set empty to use labelled straight-line estimates only.
OSRM_BASE_URL=http://127.0.0.1:5001
