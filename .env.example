# Copy to .env and adjust. Never commit .env.
DB_NAME=tripweaver
DB_USER=tripweaver
DB_PASSWORD=tripweaver
DB_URL=jdbc:postgresql://127.0.0.1:5433/tripweaver

# Optional: Google Places enrichment (Phase 11). Leave empty for provider-off mode.
GOOGLE_PLACES_API_KEY=

# Optional: routing provider base URL (self-hosted OSRM). Empty = straight-line estimates.
OSRM_BASE_URL=
